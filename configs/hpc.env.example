# Copy to configs/hpc.env (git-ignored) on the cluster and fill in real paths.
# GVHMR and GMR need two separate Python environments.
export VIDEO2REF_WORKDIR=/path/to/scratch/video2ref
export GVHMR_DIR=/path/to/ayyala-claude/third_party/GVHMR
export GMR_DIR=/path/to/ayyala-claude/third_party/GMR
export GVHMR_PYTHON=/path/to/envs/gvhmr/bin/python
export GMR_PYTHON=/path/to/envs/gmr/bin/python
export SLURM_PARTITION=gpu
export SLURM_ACCOUNT=""
export SLURM_GRES=gpu:1
export VIDEO2REF_CPUS=8
export VIDEO2REF_MEMORY=48G
export VIDEO2REF_TIME=04:00:00
